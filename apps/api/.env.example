DATABASE_URL="postgresql://kern:kern@localhost:5432/kern?schema=public"

# Сгенерируйте случайный секрет для каждого окружения, например:
#   openssl rand -hex 32
# Сервер откажется стартовать, если переменная не задана или равна
# этой строке-заглушке (см. src/config/jwt-secret.ts).
JWT_SECRET="change-me-before-any-real-deployment"
JWT_EXPIRES_IN="8h"

PORT=3000

# Origin веб-панели, разрешённый в CORS. На проде — реальный домен.
WEB_ORIGIN="http://localhost:5173"

# Логин владельца компании, создаваемый seed'ом (apps/api/prisma/seed.ts)
# при первом заполнении пустой БД. Пароль обязателен — сид упадёт с
# понятной ошибкой, если его не задать (специально: реальный пароль не
# должен лежать литералом в коде/git, см. историю seed.ts).
SEED_OWNER_EMAIL="Roman@gmail.com"
SEED_OWNER_PASSWORD=
