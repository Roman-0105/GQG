// Схема данных платформы КЕРН.
// Соответствует доменной модели из docs/project-plan.md (раздел 3) и
// ролевой модели из раздела 2. Любое изменение, ломающее совместимость,
// фиксируется отдельным ADR в docs/adr/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Компания и пользователи
// ---------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  // Компания работает в Республике Казахстан (уточнено владельцем при
  // тестировании) — тенге и Алматы вместо изначальных дефолтов "на
  // всякий случай" (рубль/Москва).
  timezone  String   @default("Asia/Almaty")
  currency  String   @default("KZT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  roles       Role[]
  sites       Site[]
  positions   Position[]
  rateRules   RateRule[]
  payrollRuns PayrollRun[]
  employees   Employee[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roleAssignments     RoleAssignment[]
  employee            Employee?
  foremanOfCrews      Crew[]           @relation("CrewForeman")
  submittedTimesheets Timesheet[]      @relation("TimesheetSubmittedBy")
  approvedTimesheets  Timesheet[]      @relation("TimesheetApprovedBy")

  createdTimesheetPeriods   TimesheetPeriod[] @relation("TimesheetPeriodCreatedBy")
  submittedTimesheetPeriods TimesheetPeriod[] @relation("TimesheetPeriodSubmittedBy")
  reviewedTimesheetPeriods  TimesheetPeriod[] @relation("TimesheetPeriodReviewedBy")
  timesheetPeriodReviews    TimesheetPeriodReview[] @relation("TimesheetPeriodReviewActor")

  foremanOfTasks Task[] @relation("TaskForeman")
  createdTasks   Task[] @relation("TaskCreatedBy")
}

// ---------------------------------------------------------------------
// Роли и права: право = (ресурс, действие, область видимости).
// Роли не зашиты в enum — владелец компании собирает свои из тех же
// прав (см. docs/project-plan.md, раздел 2).
// ---------------------------------------------------------------------

model Role {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  isSystem  Boolean @default(false) // семь базовых ролей из плана vs кастомные

  permissions Permission[]
  assignments RoleAssignment[]

  @@unique([companyId, name])
}

// resource: site | crew | employee | timesheet | payroll | rate_rule | role | analytics
// action:   create | read | update | approve | lock | delete | export
// scope:    own_crew | own_sites | company
model Permission {
  id       String @id @default(cuid())
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   String
  scope    String

  @@unique([roleId, resource, action, scope])
}

model RoleAssignment {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  roleId  String
  role    Role     @relation(fields: [roleId], references: [id])
  // Ограничивает scope "own_sites" конкретными участками, если задано.
  siteIds String[] @default([])

  @@unique([userId, roleId])
}

// ---------------------------------------------------------------------
// Административная иерархия: Компания -> Участок -> Бригада -> Сотрудник
// ---------------------------------------------------------------------

model Site {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  code           String
  description    String?
  workType       String // geology | geotech | drilling | mixed
  client         String?
  contractNumber String?
  latitude       Float?
  longitude      Float?
  budget         Decimal?  @db.Decimal(14, 2)
  status         String    @default("planned") // planned | active | paused | closed
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  // Архивация — мягкое скрытие, а не удаление: участок мог накопить
  // табели/расчёты ЗП, которые нельзя терять ради "уборки" списка.
  // Настоящее удаление участка не предлагается пользователю намеренно.
  archivedAt     DateTime?

  crews      Crew[]
  timesheets Timesheet[]
  rateRules  RateRule[]
  tasks      Task[]

  @@unique([companyId, code])
}

model Crew {
  id           String    @id @default(cuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id])
  name         String
  foremanId    String?
  foreman      User?     @relation("CrewForeman", fields: [foremanId], references: [id])
  shiftPattern String? // напр. "вахта 15/15", "дневная"
  startDate    DateTime?
  endDate      DateTime?

  members          Employee[]
  timesheets       Timesheet[]
  timesheetPeriods TimesheetPeriod[]
  tasks            Task[]
}

// ---------------------------------------------------------------------
// Задание участка (напр. "бурение скважины") — что именно бригада
// делает и с каким планом; бригадир получает задание, распределяет
// свою бригаду по сменам (день/ночь, если задание идёт вахтой в две
// смены), и уже из задания заводит табель за период — тогда участок/
// бригада/задание в табеле проставляются сами (см.
// TimesheetPeriodsService.create).
// ---------------------------------------------------------------------
model Task {
  id        String @id @default(cuid())
  siteId    String
  site      Site   @relation(fields: [siteId], references: [id])
  crewId    String
  crew      Crew   @relation(fields: [crewId], references: [id])
  foremanId String
  foreman   User   @relation("TaskForeman", fields: [foremanId], references: [id])

  wellName String
  // Проектная глубина скважины, п.м.
  projectedDepth Decimal @db.Decimal(8, 2)
  // Суточный план бурения, м/сутки.
  dailyPlan Decimal @db.Decimal(8, 2)
  // План на монтажные/демонтажные работы, часы.
  mountDismountPlanHours Decimal @db.Decimal(6, 2)
  // Есть ли ночная смена — если да, бригадир обязан распределить
  // каждого сотрудника на день/ночь (см. ShiftAssignment), не только
  // "работает/не работает".
  hasNightShift Boolean @default(false)

  createdById String
  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shiftAssignments ShiftAssignment[]
  timesheetPeriods TimesheetPeriod[]

  @@index([siteId])
  @@index([crewId])
  @@index([foremanId])
}

// Распределение сотрудника бригады на дневную/ночную смену в рамках
// конкретного задания — задаёт сам бригадир (см. requirements: "нужно
// распределить Буровика и пом-буров на дневную и ночную смену").
model ShiftAssignment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  // day | night
  shift     String
  updatedAt DateTime @updatedAt

  @@unique([taskId, employeeId])
}

// ---------------------------------------------------------------------
// Табель за период: бригадир формирует рабочий календарь бригады на
// конкретные даты (обычно из карточки задания — см. Task выше),
// заполняет сетку часов и отправляет ЦЕЛИКОМ на согласование —
// начальник участка ИЛИ бухгалтер согласовывает/отклоняет весь табель
// одним решением (см. TimesheetPeriodsService, TimesheetPeriodReview
// для истории решений). Timesheet-строки внутри периода каскадно
// следуют статусу периода — не проходят собственный цикл согласования.
// ---------------------------------------------------------------------
model TimesheetPeriod {
  id          String   @id @default(cuid())
  crewId      String
  crew        Crew     @relation(fields: [crewId], references: [id])
  // Необязательно — старые бригады без заданий продолжают заводить
  // табель напрямую из "Моя бригада". Если создаётся из карточки
  // задания, участок/бригада/задание подставляются автоматически
  // (см. TasksService / TimesheetPeriodsService.create).
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  // Одно значение на весь период, а не на каждую ячейку таблицы —
  // бригада на вахте обычно занята одним видом работ весь период;
  // если понадобится разбивка по видам работ внутри периода, отдельные
  // Timesheet-строки всё равно можно завести вручную через
  // "Внести табель" со своим workType, минуя эту сетку.
  workType    String   @default("drilling")
  // hourly | per_meter — какие сотрудники бригады (по их
  // Employee.payType) вообще попадают в сетку этого табеля, и какие
  // поля она показывает (часы vs метраж). Бригада со смешанной
  // оплатой формирует ДВА табеля на один и тот же период — по одному
  // на каждый payType (см. TimesheetPeriodsService.create) — а не один
  // с лишними полями для всех.
  payType     String   @default("hourly")

  // draft -> submitted (бригадир отправил) -> approved | rejected
  //                                            (решение одного из двух:
  //                                             начальник участка ИЛИ
  //                                             бухгалтер — не нужны обе
  //                                             подписи) -> rejected
  //                                             можно поправить и
  //                                             отправить снова (-> submitted)
  status String @default("draft")

  createdById String
  createdBy   User   @relation("TimesheetPeriodCreatedBy", fields: [createdById], references: [id])

  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("TimesheetPeriodSubmittedBy", fields: [submittedById], references: [id])

  // Кто принял решение (согласовал ИЛИ отклонил) — начальник участка
  // или бухгалтер, кто первый посмотрел; должность на момент решения
  // не хранится отдельно — берётся из текущих ролей reviewedBy при
  // отображении (см. TimesheetPeriodsService.include).
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("TimesheetPeriodReviewedBy", fields: [reviewedById], references: [id])

  // Заполняется только при отклонении (status = rejected) — последняя
  // причина для быстрого просмотра; полная история решений с
  // комментариями — TimesheetPeriodReview ниже.
  rejectionReason String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  timesheets Timesheet[]
  reviews    TimesheetPeriodReview[]

  @@index([crewId])
  @@index([taskId])
}

// История решений по табелю за период — отправка/согласование/отклонение,
// каждое со своей датой, автором и комментарием (найдено при
// тестировании: одного последнего reviewedBy/rejectionReason на
// TimesheetPeriod недостаточно, если табель отклоняли и пересылали
// несколько раз — видно только последнее решение, а не всю цепочку).
model TimesheetPeriodReview {
  id       String          @id @default(cuid())
  periodId String
  period   TimesheetPeriod @relation(fields: [periodId], references: [id])
  // submitted | approved | rejected
  action   String
  // Для submitted — необязателен, кроме повторной отправки после
  // отклонения (тогда обязателен: что исправлено или почему бригадир
  // не согласен с причиной отклонения). Для rejected — обязателен
  // (причина). Для approved — необязателен.
  comment  String?
  actorId  String
  actor    User            @relation("TimesheetPeriodReviewActor", fields: [actorId], references: [id])
  createdAt DateTime       @default(now())

  @@index([periodId])
}

model Position {
  id                 String  @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  name               String // бурильщик, геолог, помощник бурильщика, механик...
  baseHourlyRate     Decimal @db.Decimal(10, 2)
  overtimeMultiplier Decimal @default(1.5) @db.Decimal(4, 2)
  hazardPay          Boolean @default(false)

  employees Employee[]
  rateRules RateRule[]

  @@unique([companyId, name])
}

model Employee {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  crewId           String?
  crew             Crew?     @relation(fields: [crewId], references: [id])
  positionId       String
  position         Position  @relation(fields: [positionId], references: [id])
  fullName         String
  employmentType   String    @default("staff") // staff | contract | day_rate
  baseRateOverride Decimal?  @db.Decimal(10, 2)
  // hourly = платится по часам (обычные/сверхурочные/ночные), per_meter
  // = только по метражу — задаётся отдельно на каждого сотрудника
  // бригады (найдено при тестировании: буровики на метраже, геологи на
  // часах в одной и той же бригаде). Определяет, какие поля вообще
  // показывает сетка табеля за период для этого человека (см.
  // TimesheetPeriod.payType и TimesheetPeriodsService).
  payType          String    @default("hourly")
  hiredAt          DateTime?
  isActive         Boolean   @default(true)

  timesheets        Timesheet[]
  payrollLines      PayrollLine[]
  shiftAssignments  ShiftAssignment[]
}

// ---------------------------------------------------------------------
// Конструктор правил расчёта: компания -> участок -> должность,
// приоритет решает, какое правило применяется при пересечении.
// Формулы утверждает агент payroll-rules (docs/project-plan.md, раздел 4).
// ---------------------------------------------------------------------

model RateRule {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  siteId         String? // null = действует на всю компанию
  site           Site?     @relation(fields: [siteId], references: [id])
  positionId     String? // null = действует на все должности
  position       Position? @relation(fields: [positionId], references: [id])
  name           String
  nightShiftPct  Decimal   @default(0) @db.Decimal(5, 2)
  holidayPct     Decimal   @default(0) @db.Decimal(5, 2)
  remoteBonusPct Decimal   @default(0) @db.Decimal(5, 2)
  perDiemAmount  Decimal   @default(0) @db.Decimal(10, 2)
  perMeterBonus  Decimal   @default(0) @db.Decimal(10, 2)
  priority       Int       @default(0)
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------
// Табель — сквозная сущность (docs/project-plan.md, раздел 3-4)
// ---------------------------------------------------------------------

model Timesheet {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id])
  crewId            String
  crew              Crew             @relation(fields: [crewId], references: [id])
  // Заполняется, когда строка создана через таблицу одобренного
  // TimesheetPeriod, а не через одиночную форму "Внести табель" —
  // null остаётся у одиночных записей вне периодов (обратная
  // совместимость, ничего не сломано для уже существующих строк).
  timesheetPeriodId String?
  timesheetPeriod   TimesheetPeriod? @relation(fields: [timesheetPeriodId], references: [id])
  workDate          DateTime
  workType          String // drilling | standby | travel | repair | training | weather_down
  regularHours      Decimal          @db.Decimal(5, 2)
  overtimeHours     Decimal          @default(0) @db.Decimal(5, 2)
  nightHours        Decimal          @default(0) @db.Decimal(5, 2)
  // Смена в праздничный день — влияет на holidayPct в расчёте ЗП
  // (см. PayrollCalcService). Отдельное поле, а не вывод по календарю,
  // потому что список праздников/выходных различается по регионам и
  // ещё не подтверждён (docs/project-plan.md, раздел 10, пункт 1).
  isHoliday         Boolean          @default(false)
  metersDrilled     Decimal?         @db.Decimal(8, 2)
  notes             String?
  photoUrls         String[]         @default([])
  gpsLat            Float?
  gpsLng            Float?
  status            String           @default("draft") // draft | submitted | approved | locked | rejected
  // Заполняется при переходе в rejected (docs/project-plan.md, раздел 4:
  // "возврат на исправление с комментарием") — раньше согласующий мог
  // отклонить табель без единого слова объяснения, а бригадир не видел
  // в интерфейсе вообще никакого действия для уже отклонённого табеля
  // (найдено docs-writer при подготовке инструкций к Этапу 06).
  rejectionReason   String?
  // Заполняется, когда бригадир сам возвращает уже отправленную/
  // согласованную (но не заблокированную) запись на правку через
  // "Редактировать график" — по требованию обязателен комментарий,
  // почему день переоткрыт (найдено при тестировании: пропустили день
  // по невнимательности, нужно поправить и снова отправить на
  // согласование, не теряя историю о том, что это была правка задним
  // числом, а не первая отправка). Отдельное поле от rejectionReason —
  // причина отклонения от того, кто согласовывает, и причина правки от
  // того, кто вносил, — разные вещи и не должны затирать друг друга.
  correctionReason  String?
  submittedById     String?
  submittedBy       User?            @relation("TimesheetSubmittedBy", fields: [submittedById], references: [id])
  approvedById      String?
  approvedBy        User?            @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  // Штамп времени с офлайн-устройства — нужен для разрешения конфликтов
  // синхронизации (раздел 6 плана): заблокированный на сервере период
  // всегда побеждает независимо от clientCreatedAt.
  clientCreatedAt   DateTime?
  syncedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payrollLineId String?
  payrollLine   PayrollLine? @relation(fields: [payrollLineId], references: [id])

  @@index([siteId, workDate])
  @@index([employeeId, workDate])
}

// ---------------------------------------------------------------------
// Расчёт зарплаты — сквозная сущность
// ---------------------------------------------------------------------

model PayrollRun {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("draft") // draft | processed | closed
  createdAt   DateTime @default(now())

  lines PayrollLine[]
}

// Каждая сумма хранится отдельно, чтобы расчётный лист был объясним
// (см. docs/project-plan.md, раздел 4: "чёрный ящик" без объяснения не принимается).
model PayrollLine {
  id                String      @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun  @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id])
  timesheets        Timesheet[]
  baseAmount        Decimal     @db.Decimal(12, 2)
  overtimeAmount    Decimal     @default(0) @db.Decimal(12, 2)
  nightAmount       Decimal     @default(0) @db.Decimal(12, 2)
  holidayAmount     Decimal     @default(0) @db.Decimal(12, 2)
  remoteBonusAmount Decimal     @default(0) @db.Decimal(12, 2)
  perDiemAmount     Decimal     @default(0) @db.Decimal(12, 2)
  pieceRateAmount   Decimal     @default(0) @db.Decimal(12, 2)
  deductions        Decimal     @default(0) @db.Decimal(12, 2)
  advanceDeduction  Decimal     @default(0) @db.Decimal(12, 2)
  netAmount         Decimal     @db.Decimal(12, 2)
}
