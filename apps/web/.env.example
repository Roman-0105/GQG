# Только для локальной разработки (npm run dev:web, без Docker).
# Внутри Docker Compose это же значение задаётся как build-аргумент
# VITE_API_URL в корневом .env — см. .env.example в корне репозитория
# и docs/ops-runbook.md.

# Адрес backend'а, на который стучится веб-панель из браузера.
VITE_API_URL="http://localhost:3000"
