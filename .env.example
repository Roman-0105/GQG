# Переменные окружения для docker-compose.yml (пилотное развёртывание).
#
# Скопируйте этот файл в `.env` в корне репозитория и заполните реальными
# значениями:
#
#   cp .env.example .env
#
# Файл `.env` НЕ коммитится в git (см. .gitignore) — в нём секреты.
# Внутри самого приложения (apps/api) свои переменные и свой .env,
# см. apps/api/.env.example — но для запуска через Docker Compose
# используется именно этот, корневой файл: docker-compose.yml сам
# прокидывает нужные значения в контейнер api.

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=kern
# Сгенерируйте пароль и впишите сюда, например:
#   openssl rand -hex 16
# Специально оставлено пустым, а не заполнено примером-заглушкой —
# docker-compose.yml откажется стартовать с понятной ошибкой, если
# значение не заполнено, вместо того чтобы тихо завестись с паролем,
# который прочитал кто угодно, кто открывал этот репозиторий.
POSTGRES_PASSWORD=
POSTGRES_DB=kern
# Порт на хосте, на который смотрит postgres контейнера (5432 внутри).
# Меняйте, если 5432 на сервере уже занят локально установленным Postgres.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# API (NestJS, apps/api)
# ---------------------------------------------------------------------
# Сгенерируйте реальный секрет и впишите сюда, например:
#   openssl rand -hex 32
# Оставлено пустым по той же причине, что и POSTGRES_PASSWORD выше —
# сервер и так откажется стартовать с пустым/заглушечным значением
# (см. apps/api/src/config/jwt-secret.ts), но пусть это увидит уже
# docker compose при самом первом запуске, явным сообщением.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Порт на хосте для API (внутри контейнера всегда 3000).
API_PORT=3000
# Origin веб-панели, разрешённый в CORS у backend'а. Должен совпадать с
# тем, как люди реально открывают панель в браузере (см. WEB_PORT ниже
# и VITE_API_URL) — например http://192.168.1.50:8080 для доступа с
# планшетов бригадиров по Wi-Fi, а не http://localhost:8080.
WEB_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------
# Веб-панель / полевое PWA (apps/web, отдаётся через nginx)
# ---------------------------------------------------------------------
# Порт на хосте для веб-панели (внутри контейнера nginx слушает 80).
WEB_PORT=8080
# Адрес API, который увидит браузер ПОЛЬЗОВАТЕЛЯ — то есть не имя
# контейнера "api", а реальный адрес хоста с точки зрения браузера.
# ВАЖНО: это значение "запекается" в статическую сборку веб-панели на
# этапе `docker compose build`, а не читается при запуске контейнера.
# При смене адреса сервера нужно пересобрать образ web:
#   docker compose build web && docker compose up -d web
#
#   - тот же ПК, что и сервер:            http://localhost:3000
#   - другие устройства в той же сети:    http://<LAN-IP-сервера>:3000
VITE_API_URL=http://localhost:3000
